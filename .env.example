# Firebase Config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cloudflare Turnstile
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Resend (Email)
RESEND_API_KEY=

# Stripe (แพลน CapDeal) — ใส่ค่าจริงใน env ของ Vercel เท่านั้น ห้ามใส่ใน repo (repo เป็น public)
# STRIPE_SECRET_KEY ต้องเป็น Restricted key (rk_test_… / rk_live_…) ห้ามใช้ secret key ตัวเต็ม (sk_…)
#   สิทธิ์: Checkout Sessions, Customers, Billing Portal = เขียน · Subscriptions, Prices, Invoices = อ่าน
#   (ตาม PLAN-08 หลักความปลอดภัยข้อ 6) · แยก key ของ test กับ live · ห้ามมี prefix NEXT_PUBLIC_
STRIPE_SECRET_KEY=
# signing secret ของ endpoint /api/webhooks/stripe (whsec_…)
STRIPE_WEBHOOK_SECRET=
# Billing Portal configuration ของ CapDeal (bpc_…) — ไม่ใส่ = ใช้ค่าเริ่มต้นของบัญชี
STRIPE_PORTAL_CONFIG_CAPDEAL=
# Price ID ของแต่ละแพลน (price_…) — ไม่ใช่ความลับ webhook ใช้จับคู่ Price → แพลน ไม่รู้จัก = ไม่ให้แพลน
NEXT_PUBLIC_STRIPE_PRICE_ID_LITE=
NEXT_PUBLIC_STRIPE_PRICE_ID_LITE_YEARLY=
NEXT_PUBLIC_STRIPE_PRICE_ID_PRO=
NEXT_PUBLIC_STRIPE_PRICE_ID_PRO_YEARLY=
NEXT_PUBLIC_STRIPE_PRICE_ID_SCALE=
NEXT_PUBLIC_STRIPE_PRICE_ID_SCALE_YEARLY=
# อีเมลแอดมินที่รับแจ้งเตือน billingAlerts (Price ไม่รู้จัก, สมัครซ้ำ, คืนเงิน, dispute) — ไม่ใส่ = บันทึกใน Firestore อย่างเดียว
BILLING_ALERT_EMAIL=
# ใช้สร้าง URL กลับจาก Stripe และลิงก์ในอีเมล
NEXT_PUBLIC_APP_URL=

# LINE LIFF
NEXT_PUBLIC_LIFF_ID=

# LINE Login
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Other
NEXT_PUBLIC_BASE_URL=http://localhost:3000
